APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============ Integrasi DigiTrans (Biro OSDMRB) ============
# TransKinerja membaca DB DigiTrans di server yang sama (read-only).
# Login & data pegawai mengikuti DigiTrans: users JOIN employees + referensi
# (units, ranks, employment_statuses, education_levels).
DIGITRANS_AKTIF=false
DIGITRANS_DB_HOST=127.0.0.1
DIGITRANS_DB_PORT=3306
DIGITRANS_DB_DATABASE=cpaneluser_digitrans
DIGITRANS_DB_USERNAME=cpaneluser_tkreadonly
DIGITRANS_DB_PASSWORD=

# Mapping tabel/kolom — default config sudah sesuai skema asli DigiTrans
# (format "tabel.kolom"; kosongkan agar pakai default). Periksa dengan:
#   php artisan digitrans:cek
DIGITRANS_TABEL=users
DIGITRANS_KOLOM_USERNAME=
# DIGITRANS_KOLOM_NIP=employees.nip
# DIGITRANS_KOLOM_NAMA=employees.name
# DIGITRANS_KOLOM_EMAIL=users.email
# DIGITRANS_KOLOM_PASSWORD=users.password
# DIGITRANS_KOLOM_JABATAN=employees.position_name
# DIGITRANS_KOLOM_UNIT=units.name
# DIGITRANS_KOLOM_AKTIF=users.is_active

# Perilaku
DIGITRANS_LOGIN=true
DIGITRANS_SINKRON=true
DIGITRANS_AUTO_PROVISION=true
DIGITRANS_ROLE_BAWAAN=pegawai
